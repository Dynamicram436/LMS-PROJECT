{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "checkJs": false,
    "allowJs": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": false,
    "noImplicitAny": false
  },
  "include": ["**/*"],
  "exclude": ["node_modules"]
}

