{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "checkJs": false,
    "allowJs": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": false,
    "noImplicitAny": false,
    "ignoreDeprecations": "6.0"
  },
  "include": ["**/*"],
  "exclude": ["node_modules"]
}

